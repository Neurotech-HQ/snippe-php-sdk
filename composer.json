{
    "name": "snippe/snippe-php",
    "description": "Official PHP SDK for Snippe Payment API - Simple mobile money, card & QR payments",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "snippe",
        "payments",
        "mobile-money",
        "mpesa",
        "airtel",
        "tanzania",
        "payment-gateway",
        "qr-payments",
        "card-payments"
    ],
    "homepage": "https://github.com/snippe/snippe-php",
    "authors": [
        {
            "name": "Snippe",
            "email": "dev@snippe.sh",
            "homepage": "https://snippe.sh"
        }
    ],
    "support": {
        "issues": "https://github.com/snippe/snippe-php/issues",
        "source": "https://github.com/snippe/snippe-php"
    },
    "autoload": {
        "psr-4": {
            "Snippe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Snippe\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "scripts": {
        "test": "phpunit tests/"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
